build/
dist/
.deps/
# Per-installation gateway address. Never commit it.
app.local.properties

# Emulator harness state. The app writes a setup backup here, which is
# restored on the next run and makes the harness behave differently.
app/build/emu/rms/

# Python bytecode from tools/
__pycache__/
*.pyc
